# CMake settings that point aws-c-* (find_package(OpenSSL)), s2n (Findcrypto)
# and HDF5 at OpenBSD's OpenSSL 3.5 package instead of base LibreSSL.
O=/usr/local/lib/eopenssl35
OSSL="-DOPENSSL_INCLUDE_DIR=/usr/local/include/eopenssl35 -DOPENSSL_CRYPTO_LIBRARY=$O/libcrypto.so.37.0 -DOPENSSL_SSL_LIBRARY=$O/libssl.so.37.0 -Dcrypto_INCLUDE_DIR=/usr/local/include/eopenssl35 -Dcrypto_LIBRARY=$O/libcrypto.so.37.0 -Dcrypto_SHARED_LIBRARY=$O/libcrypto.so.37.0"
